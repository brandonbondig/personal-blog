---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  lang?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  lang,
  pubDatetime,
  modDatetime,
} = Astro.props;

const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

const author = {
  "@type": "Person",
  name: site.author,
  ...(site.profile && { url: site.profile }),
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  ...(ogImage && { image: ogImage }),
  mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
  url: pageURL,
  inLanguage: lang ?? site.lang,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...((modDatetime ?? pubDatetime) && {
    dateModified: (modDatetime ?? pubDatetime)?.toISOString(),
  }),
  author: [author],
  publisher: author,
};
---

<Layout {title} {description} {ogImage} {canonicalURL} {lang} ogType="article">
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    <meta property="article:author" content={site.author} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
